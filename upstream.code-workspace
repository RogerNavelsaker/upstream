      "**/.flox": true
    },
    "git.detectSubmodules": false
  },
  "extensions": {
    "recommendations": [
      "mkhl.direnv",
      "oven.bun-vscode",
      "biomejs.biome",
      "github.vscode-github-actions",
      "github.vscode-pull-request-github"
    ]
  }
}
